DATABASE_URL=sqlite:////app/instance/scorm_classroom.db
MAX_UPLOAD_MB=300
UPLOAD_ROOT=/app/uploads/scorm
LOCAL_TIMEZONE=Atlantic/Canary
DEV_AUTH=false

# Caddy: dominio para HTTPS automático. Para prueba HTTP usa http://:80
