# Acceso por enlace sin Google
CLASSROOM_ENABLED=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Google OAuth / Classroom Add-on: OPCIONAL
GOOGLE_CLIENT_ID=
